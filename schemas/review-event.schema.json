{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/review-event.schema.json",
  "title": "V3 append-only targeted review event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "actor", "operation", "target_id", "field", "value", "note", "target_event_id"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "event_id": {"type": "string", "pattern": "^REV-P[0-9]{2,}-[0-9]{6}$"},
    "recorded_at": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "operation": {"enum": ["set", "resolve_issue", "note", "retract"]},
    "target_id": {"type": ["string", "null"]},
    "field": {"type": ["string", "null"]},
    "value": {},
    "note": {"type": "string", "minLength": 1},
    "target_event_id": {"type": ["string", "null"]}
  }
}
