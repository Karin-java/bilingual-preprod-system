{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/pipeline-state.schema.json",
  "title": "V3 lightweight pipeline checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "status", "chapters", "next_task", "catalog_metrics", "review_summary"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "pipeline_version": {"const": "3.0.0"},
    "status": {"enum": ["waiting_for_agent", "needs_repair", "ready_for_review", "complete"]},
    "chapters": {"type": "array"},
    "next_task": {"type": ["object", "null"]},
    "catalog_metrics": {"type": "object"},
    "review_summary": {"type": "object"}
  }
}
