{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/recap-review-event.schema.json",
  "title": "Append-only profile recap acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "actor", "operation", "character_id", "task_sha256", "note", "target_event_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^RECAPREV-[0-9]{6}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "label"], "properties": {"type": {"enum": ["user", "agent"]}, "label": {"type": "string", "minLength": 1}}},
    "operation": {"enum": ["accept_task", "retract_event"]},
    "character_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/characterId"}, {"type": "null"}]},
    "task_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "note": {"type": "string", "minLength": 1},
    "target_event_id": {"type": ["string", "null"], "pattern": "^RECAPREV-[0-9]{6}$"}
  }
}
