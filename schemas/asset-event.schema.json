{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/asset-event.schema.json",
  "title": "V3 human asset-scope decision event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "actor", "operation", "asset_id", "target_asset_id", "status", "name_zh", "scene_ids", "note", "target_event_id"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "event_id": {"type": "string", "pattern": "^ASREV-[0-9]{6}$"},
    "recorded_at": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "operation": {"enum": ["decide", "merge", "split", "retract"]},
    "asset_id": {"type": ["string", "null"]},
    "target_asset_id": {"type": ["string", "null"]},
    "status": {"enum": ["pending", "approved", "excluded", "information_pending", null]},
    "name_zh": {"type": ["string", "null"]},
    "scene_ids": {"type": ["array", "null"], "items": {"type": "string"}},
    "note": {"type": "string", "minLength": 1},
    "target_event_id": {"type": ["string", "null"]}
  }
}
