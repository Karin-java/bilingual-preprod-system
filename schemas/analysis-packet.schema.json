{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/analysis-packet.schema.json",
  "title": "Chapter analysis work packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "project_id", "chapter_id", "source_sha256", "source_unit_ids", "rules_ref", "output_schema_ref", "output_path", "registry_context", "units"],
  "properties": {
    "packet_version": {"const": "1.1.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[a-z0-9][a-z0-9-]{0,62}$"},
    "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
    "rules_ref": {"const": "references/analysis_rules.md"},
    "output_schema_ref": {"const": "schemas/chapter-analysis.schema.json"},
    "output_path": {"type": "string", "pattern": "^data/analysis/p[0-9]{2,}[.]analysis[.]json$"},
    "registry_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_version", "registry_sha256", "profile_sha256", "selection_strategy", "total_characters", "total_locations", "characters", "locations"],
      "properties": {
        "registry_version": {"type": ["string", "null"]},
        "registry_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "profile_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "selection_strategy": {"const": "lexical-major-recent-v1"},
        "total_characters": {"type": "integer", "minimum": 0},
        "total_locations": {"type": "integer", "minimum": 0},
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character_id", "entity_keys", "canonical_name", "chinese_name", "aliases", "chinese_aliases", "profile_fields"],
            "properties": {
              "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
              "entity_keys": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/entityKey"}},
              "canonical_name": {"type": "string", "minLength": 1},
              "chinese_name": {"type": ["string", "null"]},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "chinese_aliases": {"type": "array", "items": {"type": "string"}},
              "profile_fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value_zh", "status"],
                  "properties": {
                    "value_zh": {"type": ["string", "null"]},
                    "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"}
                  }
                }
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location_id", "entity_keys", "canonical_name", "aliases", "parent_names", "sub_locations"],
            "properties": {
              "location_id": {"$ref": "common.schema.json#/$defs/locationId"},
              "entity_keys": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/entityKey"}},
              "canonical_name": {"type": "string", "minLength": 1},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "parent_names": {"type": "array", "items": {"type": "string"}},
              "sub_locations": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "source_text"],
        "properties": {
          "unit_id": {"$ref": "common.schema.json#/$defs/sourceUnitId"},
          "source_text": {"type": "string"}
        }
      }
    }
  }
}
