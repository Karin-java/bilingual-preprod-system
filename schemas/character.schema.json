{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/character.schema.json",
  "title": "Character registry record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "canonical_name", "chinese_name", "aliases", "character_type", "importance", "evidence"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
    "canonical_name": {"type": "string", "minLength": 1},
    "chinese_name": {"type": ["string", "null"]},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "character_type": {"enum": ["named", "role", "crowd", "unknown"]},
    "importance": {"enum": ["major", "candidate_major", "supporting", "minor", "unknown"]},
    "first_appearance_id": {"type": ["string", "null"], "pattern": "^APP-P[0-9]{2,}-[0-9]{4}$"},
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}}
  }
}
