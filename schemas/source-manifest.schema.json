{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/source-manifest.schema.json",
  "title": "V3 immutable source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source", "canonical", "chapter_detection", "chapters"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[a-z0-9][a-z0-9-]{0,62}$"},
    "source": {"type": "object", "required": ["filename", "format", "encoding", "copy_path", "byte_length", "sha256", "warnings"]},
    "canonical": {"type": "object", "required": ["path", "encoding", "character_length", "byte_length", "sha256", "rule"]},
    "chapter_detection": {"type": "object", "required": ["method", "status", "warnings"]},
    "chapters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chapter_id", "ordinal", "heading", "source_label", "source_start", "source_end", "character_length", "sha256", "source_path"],
        "properties": {
          "chapter_id": {"type": "string", "pattern": "^P[0-9]{2,}$"},
          "ordinal": {"type": "integer", "minimum": 0},
          "heading": {"type": ["string", "null"]},
          "source_label": {"type": ["string", "null"]},
          "source_start": {"type": "integer", "minimum": 0},
          "source_end": {"type": "integer", "minimum": 1},
          "character_length": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_path": {"type": "string", "pattern": "^source/chapters/p[0-9]{2,}[.]txt$"}
        }
      }
    }
  }
}
