{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/extension-manifest.schema.json",
  "title": "Pre-production extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "module_id", "module_version", "display_name", "execution_mode", "consumes", "produces", "output_namespace", "delivery_path_patterns", "entrypoint"],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "module_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "execution_mode": {"enum": ["deterministic", "agent_task"]},
    "consumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data_type", "version_range"],
        "properties": {
          "data_type": {"type": "string", "minLength": 1},
          "version_range": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "produces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "format"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "jsonl", "markdown", "csv", "html", "pdf", "image", "other"]}
        }
      }
    },
    "output_namespace": {"type": "string", "pattern": "^extensions/[a-z][a-z0-9-]{1,62}/$"},
    "delivery_path_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(deliverables|extensions/[a-z][a-z0-9-]{1,62})/"}
    },
    "entrypoint": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+[.]py:prepare$"},
    "config_schema": {"type": ["string", "null"]}
  }
}
