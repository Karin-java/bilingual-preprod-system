{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/pipeline-task.schema.json",
  "title": "Single next agent task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_type", "chapter_id", "character_id", "target_label", "input_path", "input_sha256", "output_path", "instructions", "reason", "input_utf8_bytes", "estimated_input_tokens_min", "estimated_input_tokens_max", "token_estimate_method", "review_scope_sha256", "task_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_type": {"enum": ["analyze_chapter", "repair_chapter", "review_character_profile"]},
    "chapter_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/chapterId"}, {"type": "null"}]},
    "character_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/characterId"}, {"type": "null"}]},
    "target_label": {"type": "string", "minLength": 1},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_path": {"type": ["string", "null"]},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_utf8_bytes": {"type": "integer", "minimum": 0},
    "estimated_input_tokens_min": {"type": "integer", "minimum": 0},
    "estimated_input_tokens_max": {"type": "integer", "minimum": 0},
    "token_estimate_method": {"const": "character-class-range-v1; actual usage depends on model tokenizer"},
    "review_scope_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
