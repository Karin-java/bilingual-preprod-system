{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/chapter-analysis.schema.json",
  "title": "Chapter analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter_id", "source_sha256", "source_unit_ids", "scenes"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "ordinal", "int_ext", "location_name", "time_of_day", "source_unit_ids", "evidence", "beats"],
        "properties": {
          "scene_id": {"$ref": "common.schema.json#/$defs/sceneId"},
          "ordinal": {"type": "integer", "minimum": 1},
          "int_ext": {"enum": ["INT", "EXT", "INT_EXT", "unknown"]},
          "location_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/locationId"}, {"type": "null"}]},
          "location_name": {"type": ["string", "null"]},
          "parent_location": {"type": ["string", "null"]},
          "sub_location": {"type": ["string", "null"]},
          "time_of_day": {"enum": ["day", "night", "dawn", "morning", "noon", "afternoon", "dusk", "continuous", "unknown"]},
          "reality_layer": {"enum": ["present", "flashback", "dream", "imagined", "unknown"]},
          "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}},
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beat_id", "ordinal", "summary_zh", "change_type", "source_unit_ids"],
              "properties": {
                "beat_id": {"$ref": "common.schema.json#/$defs/beatId"},
                "ordinal": {"type": "integer", "minimum": 1},
                "summary_zh": {"type": "string", "minLength": 1},
                "change_type": {"enum": ["opening", "goal", "conflict", "revelation", "emotion", "power_shift", "character_entry", "action", "other"]},
                "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}}
              }
            }
          }
        }
      }
    }
  }
}
