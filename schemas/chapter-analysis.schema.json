{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/chapter-analysis.schema.json",
  "title": "Chapter semantic analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_method", "chapter_id", "source_sha256", "input_packet_sha256", "source_unit_ids", "unit_analyses", "scenes", "character_observations", "profile_observations", "review"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "analysis_method": {"const": "agent-semantic-v1"},
    "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
    "unit_analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "segments"],
        "properties": {
          "unit_id": {"$ref": "common.schema.json#/$defs/sourceUnitId"},
          "segments": {"type": "array", "items": {"$ref": "text-segment.schema.json"}}
        }
      }
    },
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "character_observations": {"type": "array", "items": {"$ref": "#/$defs/characterObservation"}},
    "profile_observations": {"type": "array", "items": {"$ref": "#/$defs/profileObservation"}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {"enum": ["ready", "provisional"]},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue_id", "scope_type", "scope_id", "field_path", "code", "message", "source_unit_ids"],
            "properties": {
              "issue_id": {"$ref": "common.schema.json#/$defs/reviewIssueId"},
              "scope_type": {"enum": ["chapter", "scene", "beat", "source_unit", "segment", "character_observation", "profile_observation"]},
              "scope_id": {"type": "string", "minLength": 1},
              "field_path": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
              "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
              "message": {"type": "string", "minLength": 1},
              "source_unit_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "profileObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_observation_id", "entity_key", "matched_character_id", "field", "value_zh", "normalized_value", "status", "confidence", "source_unit_ids", "evidence", "note_zh"],
      "properties": {
        "profile_observation_id": {"$ref": "common.schema.json#/$defs/profileObservationId"},
        "entity_key": {"$ref": "common.schema.json#/$defs/entityKey"},
        "matched_character_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/characterId"}, {"type": "null"}]},
        "field": {"enum": ["age", "gender", "race", "identity", "appearance", "hair", "body_type", "special_marks", "clothing", "personality", "story_role", "basic_info_summary"]},
        "value_zh": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "status": {"enum": ["explicit", "inferred", "user_confirmed"]},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}},
        "note_zh": {"type": "string"}
      }
    },
    "characterObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "entity_key", "matched_character_id", "canonical_label", "chinese_label", "aliases", "chinese_aliases", "character_type", "importance_hint", "scene_id", "presence_type", "has_dialogue", "speaker_segment_ids", "source_unit_ids", "status", "confidence", "evidence"],
      "properties": {
        "observation_id": {"$ref": "common.schema.json#/$defs/characterObservationId"},
        "entity_key": {"$ref": "common.schema.json#/$defs/entityKey"},
        "matched_character_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/characterId"}, {"type": "null"}]},
        "canonical_label": {"type": "string", "minLength": 1},
        "chinese_label": {"type": ["string", "null"]},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "chinese_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "summary_zh": {"type": "string", "minLength": 1},
        "character_type": {"enum": ["named", "role", "crowd"]},
        "importance_hint": {"enum": ["candidate_major", "supporting", "minor", "unknown"]},
        "scene_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/sceneId"}, {"type": "null"}]},
        "presence_type": {"enum": ["physical", "dream", "flashback", "mentioned", "unknown"]},
        "has_dialogue": {"type": "boolean"},
        "speaker_segment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/segmentId"}},
        "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "confidence", "evidence"],
      "properties": {
        "value": {},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id", "source_text", "standardized_name", "parent_location", "sub_location", "status", "confidence", "evidence"],
      "properties": {
        "location_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/locationId"}, {"type": "null"}]},
        "source_text": {"type": ["string", "null"]},
        "standardized_name": {"type": ["string", "null"]},
        "parent_location": {"type": ["string", "null"]},
        "sub_location": {"type": ["string", "null"]},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "ordinal", "summary_zh", "change_type", "source_unit_ids", "status", "confidence", "evidence"],
      "properties": {
        "beat_id": {"$ref": "common.schema.json#/$defs/beatId"},
        "ordinal": {"type": "integer", "minimum": 1},
        "summary_zh": {"type": "string", "minLength": 1},
        "change_type": {"enum": ["opening", "goal", "conflict", "revelation", "emotion", "power_shift", "character_entry", "action", "other"]},
        "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "ordinal", "summary_zh", "location", "int_ext", "time_of_day", "reality_layer", "source_unit_ids", "boundary_evidence", "beats"],
      "properties": {
        "scene_id": {"$ref": "common.schema.json#/$defs/sceneId"},
        "ordinal": {"type": "integer", "minimum": 1},
        "summary_zh": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "int_ext": {"allOf": [{"$ref": "#/$defs/assessment"}, {"properties": {"value": {"enum": ["INT", "EXT", "INT_EXT", "unknown"]}}}]},
        "time_of_day": {"allOf": [{"$ref": "#/$defs/assessment"}, {"properties": {"value": {"enum": ["day", "night", "dawn", "morning", "noon", "afternoon", "dusk", "continuous", "unknown"]}}}]},
        "reality_layer": {"allOf": [{"$ref": "#/$defs/assessment"}, {"properties": {"value": {"enum": ["present", "flashback", "dream", "imagined", "unknown"]}}}]},
        "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
        "boundary_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}},
        "beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/beat"}}
      }
    }
  }
}
