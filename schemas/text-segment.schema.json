{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/text-segment.schema.json",
  "title": "Semantic text segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segment_id", "unit_id", "ordinal", "start", "end", "source_text", "translation", "text_type", "classification", "speaker"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "segment_id": {"$ref": "common.schema.json#/$defs/segmentId"},
    "unit_id": {"$ref": "common.schema.json#/$defs/sourceUnitId"},
    "ordinal": {"type": "integer", "minimum": 1},
    "start": {"type": "integer", "minimum": 0},
    "end": {"type": "integer", "minimum": 1},
    "source_text": {"type": "string", "minLength": 1},
    "translation": {"$ref": "#/$defs/translation"},
    "text_type": {"enum": ["chapter_heading", "scene_heading", "action", "narration", "dialogue", "inner_thought", "voice_over", "letter", "on_screen_text", "transition", "other"]},
    "classification": {"$ref": "#/$defs/assessment"},
    "speaker": {}
  },
  "allOf": [
    {
      "if": {"properties": {"text_type": {"enum": ["dialogue", "inner_thought", "voice_over"]}}},
      "then": {"properties": {"speaker": {"$ref": "#/$defs/speaker"}}},
      "else": {"properties": {"speaker": {"type": "null"}}}
    }
  ],
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_zh", "status"],
      "properties": {
        "text_zh": {"type": "string", "minLength": 1},
        "status": {"enum": ["agent_draft", "user_confirmed"]}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "evidence"],
      "properties": {
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_label", "chinese_label", "character_id", "status", "confidence", "evidence"],
      "properties": {
        "kind": {"enum": ["named", "role", "crowd", "unknown"]},
        "canonical_label": {"type": ["string", "null"]},
        "chinese_label": {"type": ["string", "null"]},
        "character_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/characterId"}, {"type": "null"}]},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
      }
    }
  }
}
