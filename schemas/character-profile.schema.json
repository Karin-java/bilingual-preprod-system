{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/character-profile.schema.json",
  "title": "Materialized cross-chapter character profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "canonical_name", "chinese_name", "basic_info_summary_zh", "fields"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
    "canonical_name": {"type": "string", "minLength": 1},
    "chinese_name": {"type": ["string", "null"]},
    "basic_info_summary_zh": {"type": "string", "minLength": 1},
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "gender", "race", "identity", "appearance", "hair", "body_type", "special_marks", "clothing", "personality", "story_role"],
      "properties": {
        "age": {"$ref": "#/$defs/profileField"},
        "gender": {"$ref": "#/$defs/profileField"},
        "race": {"$ref": "#/$defs/profileField"},
        "identity": {"$ref": "#/$defs/profileField"},
        "appearance": {"$ref": "#/$defs/profileField"},
        "hair": {"$ref": "#/$defs/profileField"},
        "body_type": {"$ref": "#/$defs/profileField"},
        "special_marks": {"$ref": "#/$defs/profileField"},
        "clothing": {"$ref": "#/$defs/profileField"},
        "personality": {"$ref": "#/$defs/profileField"},
        "story_role": {"$ref": "#/$defs/profileField"}
      }
    }
  },
  "$defs": {
    "profileField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_zh", "status", "fact_ids", "facts"],
      "properties": {
        "value_zh": {"type": ["string", "null"]},
        "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
        "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "unknown"}}},
        "then": {"properties": {"value_zh": {"type": "null"}, "fact_ids": {"maxItems": 0}, "facts": {"maxItems": 0}}}
      }]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "origin", "field", "value_zh", "normalized_value", "status", "confidence", "chapter_ids", "source_unit_ids", "evidence", "note_zh"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "origin": {"enum": ["chapter_observation", "profile_decision"]},
        "field": {"type": "string", "minLength": 1},
        "value_zh": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "status": {"enum": ["explicit", "inferred", "user_confirmed"]},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "chapter_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/chapterId"}},
        "source_unit_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}},
        "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}},
        "note_zh": {"type": "string"}
      }
    }
  }
}
