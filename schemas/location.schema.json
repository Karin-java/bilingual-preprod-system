{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/location.schema.json",
  "title": "Location registry record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "location_id", "entity_keys", "canonical_name", "aliases", "parent_names", "sub_locations", "first_scene_id", "scene_ids", "chapter_ids", "status", "evidence"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "location_id": {"$ref": "common.schema.json#/$defs/locationId"},
    "entity_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/entityKey"}},
    "canonical_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sub_locations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "first_scene_id": {"$ref": "common.schema.json#/$defs/sceneId"},
    "scene_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sceneId"}},
    "chapter_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/chapterId"}},
    "status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
  }
}
