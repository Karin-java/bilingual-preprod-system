{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "sourceUnitId": {"type": "string", "pattern": "^P[0-9]{2,}-U[0-9]{4}$"},
    "segmentId": {"type": "string", "pattern": "^P[0-9]{2,}-U[0-9]{4}-G[0-9]{3}$"},
    "chapterId": {"type": "string", "pattern": "^P[0-9]{2,}$"},
    "sceneId": {"type": "string", "pattern": "^P[0-9]{2,}-S[0-9]{3}$"},
    "beatId": {"type": "string", "pattern": "^P[0-9]{2,}-S[0-9]{3}-B[0-9]{3}$"},
    "reviewIssueId": {"type": "string", "pattern": "^ISS-P[0-9]{2,}-[0-9]{4}$"},
    "reviewEventId": {"type": "string", "pattern": "^REV-P[0-9]{2,}-[0-9]{6}$"},
    "characterId": {"type": "string", "pattern": "^CHAR-[0-9]{4}$"},
    "locationId": {"type": "string", "pattern": "^LOC-[0-9]{4}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_unit_id", "quote"],
      "properties": {
        "source_unit_id": {"$ref": "#/$defs/sourceUnitId"},
        "quote": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "assessmentStatus": {
      "enum": ["explicit", "inferred", "user_confirmed", "conflict", "unknown"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
