{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/profile-bundle.schema.json",
  "title": "Cross-chapter character profile bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "registry_input", "analysis_inputs", "decision_log", "required_fields", "profiles", "recap_tasks"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "profile_version": {"const": "character-profile-v1"},
    "registry_input": {"$ref": "#/$defs/input"},
    "analysis_inputs": {"type": "array", "items": {"$ref": "#/$defs/chapterInput"}},
    "decision_log": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "active_event_ids", "retracted_event_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "active_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/profileDecisionEventId"}},
        "retracted_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/profileDecisionEventId"}}
      }
    },
    "required_fields": {"const": ["age", "gender", "race", "identity", "appearance", "hair", "body_type", "special_marks", "clothing", "personality", "story_role"]},
    "profiles": {"type": "array", "items": {"$ref": "character-profile.schema.json"}},
    "recap_tasks": {"type": "array", "items": {"$ref": "#/$defs/recapTask"}},
    "unresolved_profile_observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/profileObservationId"}}
  },
  "$defs": {
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "chapterInput": {
      "type": "object", "additionalProperties": false, "required": ["chapter_id", "path", "sha256"],
      "properties": {
        "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "recapTask": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "character_id", "fields", "context_clues"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^RECAP-[0-9]{4}$"},
        "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
        "fields": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "reason", "current_value_zh"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "reason": {"enum": ["unknown", "conflict", "inference_needs_confirmation"]},
            "current_value_zh": {"type": ["string", "null"]}
          }
        }},
        "context_clues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_unit_id", "quote_en", "translation_zh"], "properties": {"source_unit_id": {"$ref": "common.schema.json#/$defs/sourceUnitId"}, "quote_en": {"type": "string", "minLength": 1}, "translation_zh": {"type": "string", "minLength": 1}}}}
      }
    }
  }
}
