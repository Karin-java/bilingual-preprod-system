{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/appearance-bundle.schema.json",
  "title": "Appearance records and deterministic report views",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "appearance_version", "registry_input", "analysis_inputs", "major_selection", "appearances", "unregistered_observation_ids", "chapter_rows", "major_character_scenes"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "appearance_version": {"const": "appearance-registry-v1"},
    "registry_input": {"$ref": "#/$defs/input"},
    "analysis_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "path", "sha256"],
        "properties": {
          "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "major_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "included_importance", "provisional"],
      "properties": {
        "strategy": {"const": "registry-importance-v1"},
        "included_importance": {"const": ["major", "candidate_major"]},
        "provisional": {"type": "boolean"}
      }
    },
    "appearances": {"type": "array", "items": {"$ref": "appearance.schema.json"}},
    "unregistered_observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/characterObservationId"}},
    "chapter_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "chapter_id", "appearance_ids", "status", "appearance_types", "on_screen_scene_ids", "dialogue_scene_ids", "mentioned_only_scene_ids", "unknown_scene_ids"],
        "properties": {
          "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
          "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
          "appearance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^APP-P[0-9]{2,}-[0-9]{4}$"}},
          "status": {"enum": ["on_screen", "on_screen_and_mentioned", "mentioned_only", "unknown"]},
          "appearance_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["physical", "flashback", "dream", "mentioned", "unknown"]}},
          "on_screen_scene_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sceneId"}},
          "dialogue_scene_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sceneId"}},
          "mentioned_only_scene_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sceneId"}},
          "unknown_scene_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sceneId"}}
        }
      }
    },
    "major_character_scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "chapter_id", "scene_id", "scene_ordinal", "appearance_ids", "appearance_types", "has_dialogue", "location_name", "location_status", "summary_zh", "source_unit_ids"],
        "properties": {
          "character_id": {"$ref": "common.schema.json#/$defs/characterId"},
          "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
          "scene_id": {"$ref": "common.schema.json#/$defs/sceneId"},
          "scene_ordinal": {"type": "integer", "minimum": 1},
          "appearance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^APP-P[0-9]{2,}-[0-9]{4}$"}},
          "appearance_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["physical", "flashback", "dream"]}},
          "has_dialogue": {"type": "boolean"},
          "location_name": {"type": ["string", "null"]},
          "location_status": {"$ref": "common.schema.json#/$defs/assessmentStatus"},
          "summary_zh": {"type": "string", "minLength": 1},
          "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceUnitId"}}
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
