{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/resolved-view-manifest.schema.json",
  "title": "Resolved chapter view manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter_id", "base_analysis_path", "base_analysis_sha256", "events_path", "events_sha256", "resolved_analysis_path", "resolved_analysis_sha256", "applied_event_ids", "retracted_event_ids", "resolved_issue_ids", "open_issue_ids", "review_notes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "chapter_id": {"$ref": "common.schema.json#/$defs/chapterId"},
    "base_analysis_path": {"type": "string", "minLength": 1},
    "base_analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "events_path": {"type": "string", "minLength": 1},
    "events_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resolved_analysis_path": {"type": "string", "minLength": 1},
    "resolved_analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applied_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reviewEventId"}},
    "retracted_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reviewEventId"}},
    "resolved_issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reviewIssueId"}},
    "open_issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reviewIssueId"}},
    "review_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "scope_type", "scope_id", "note"],
        "properties": {
          "event_id": {"$ref": "common.schema.json#/$defs/reviewEventId"},
          "scope_type": {"enum": ["chapter", "scene", "beat", "source_unit", "segment", "character_observation"]},
          "scope_id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
