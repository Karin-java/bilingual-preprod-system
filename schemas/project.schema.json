{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/project.schema.json",
  "title": "V3 pre-production project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "pipeline_version", "state", "source_manifest", "artifacts"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[a-z0-9][a-z0-9-]{0,62}$"},
    "title": {"type": "string", "minLength": 1},
    "pipeline_version": {"const": "3.0.0"},
    "state": {"enum": ["ingested", "structured", "validated"]},
    "source_manifest": {"const": "source/manifest.json"},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  }
}
