{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilingual-preprod.local/schemas/project.schema.json",
  "title": "Pre-production project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "pipeline_version", "state", "source_manifest", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[a-z0-9][a-z0-9-]{0,62}$"},
    "title": {"type": "string", "minLength": 1},
    "pipeline_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "state": {"enum": ["ingested", "structured", "rendered", "validated"]},
    "source_manifest": {"const": "source/manifest.json"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "path", "schema_version", "sha256"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "schema_version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
