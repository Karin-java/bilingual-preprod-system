{
  "manifest_version": "1.0.0",
  "module_id": "art-prompts",
  "module_version": "1.0.0",
  "display_name": "美术提示词任务",
  "description": "为单个场景准备有证据、低上下文消耗的美术提示词事实包。",
  "execution_mode": "agent_task",
  "consumes": [
    {"data_type": "chapter-analysis", "version_range": "2.x", "required": true},
    {"data_type": "entity-registry", "version_range": "2.x", "required": true},
    {"data_type": "appearance-bundle", "version_range": "2.x", "required": true},
    {"data_type": "profile-bundle", "version_range": "2.x", "required": true}
  ],
  "produces": [
    {"artifact_type": "art-prompt-packet", "format": "json"},
    {"artifact_type": "scene-art-prompt", "format": "markdown"}
  ],
  "output_namespace": "extensions/art-prompts/",
  "delivery_path_patterns": ["deliverables/art_prompts/*.md"],
  "entrypoint": "extensions/art-prompts/handler.py:prepare",
  "config_schema": null
}
